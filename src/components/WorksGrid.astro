---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  works: CollectionEntry<'works'>[];
}
const { works } = Astro.props;

const largeImages = await Promise.all(
  works.map((work) => getImage({ src: work.data.image, width: 1400 })),
);
---

<div class="grid">
  {
    works.map((work, i) => (
      <button
        class="thumb"
        type="button"
        data-full={largeImages[i].src}
        data-title={work.data.title}
        data-year={work.data.year}
        data-desc-id={`desc-${work.id}`}
      >
        <Image src={work.data.image} alt={work.data.title} height={520} loading="lazy" />
      </button>
    ))
  }
</div>

<style>
  .grid {
    --thumb-height: 300px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .thumb {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    gap: 0.4rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
  }
  .thumb img {
    display: block;
    height: var(--thumb-height);
    width: auto;
    max-width: 100%;
    /* falls back to letterboxing (never distorts) if max-width caps the width on narrow screens */
    object-fit: contain;
    border-radius: 4px;
    transition: opacity 0.15s ease;
  }
  @media (max-width: 600px) {
    .grid {
      --thumb-height: 160px;
    }
  }
  .thumb:hover img {
    opacity: 0.85;
  }
</style>
